# ==============================================================================
# RESII — Root .gitignore (Public Repository Security & Cleanliness Baseline)
# ==============================================================================

# 1. Environment & Secrets (Never commit credentials)
.env
.env.*
!.env.example
infra/.env
*.pem
*.key
*.cert
*.crt

# 2. Local Database & State (CRITICAL PII: User accounts & sessions)
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# 3. Candidate Uploads & Document Storage (CRITICAL PII: Resumes)
data/uploads/
data/backups/
*.bin

# 4. Node.js & Web Build Artifacts
node_modules/
web/node_modules/
marketing/node_modules/
extension/node_modules/
web/dist/
web/dist-ssr/
marketing/.next/
marketing/out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. Browser Extension Compiled Artifacts
extension/dist/

# 6. Python Bytecode, Caches & Virtual Environments
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
env/
venv/
.venv/
ENV/
build/
dist/
*.egg-info/

# 7. Temporary Files, Logs & Scratchpad
scratch/
*.log
.DS_Store
Thumbs.db
*.bak
*.swp
*.swo
*~

{
  "manifest_version": 3,
  "name": "RESII — AI Application Autofill & Tracker",
  "version": "1.0.0",
  "description": "Human-supervised AI application assistant connecting RESII intelligence to Greenhouse, Lever, Workday, and custom career portals.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "RESII Application Assistant"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.linkedin.com/jobs/*",
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content/index.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8100/*",
    "http://localhost:8100/*",
    "https://*/*"
  ]
}

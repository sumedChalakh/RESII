# ==============================================================================
# RESII — Unified Application Environment Configuration Template (.env.example)
#
# Ground truth configuration extracted directly from api/config.py.
# Copy this file to .env and customize for your environment.
# Never commit the populated .env file to public version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application Environment
# ------------------------------------------------------------------------------
# Environment mode: 'development' or 'production'.
# In production, strict security validation is enforced at startup (api/config.py:76).
ENVIRONMENT=development

# Application name displayed in API OpenAPI documentation.
APP_NAME="RESII API"

# Cryptographic secret for signing HttpOnly session cookies (HMAC-SHA256)
# and generating double-submit CSRF tokens.
# REQUIRED IN PRODUCTION (minimum 32 characters; default dev secret rejected in prod).
SECRET_KEY=change_me_to_a_cryptographically_secure_random_64_char_string_2026

# Symmetric key used to encrypt stored third-party credentials.
# REQUIRED IN PRODUCTION (minimum 16 characters).
CREDENTIAL_ENCRYPTION_KEY=change_me_to_a_secure_encryption_key_min_16_chars

# ------------------------------------------------------------------------------
# 2. Host, Ports & Networking URLs
# ------------------------------------------------------------------------------
API_HOST=0.0.0.0
PORT=8100
API_URL=http://localhost:8100
FRONTEND_URL=http://localhost:5173
MARKETING_URL=http://localhost:3000

# Trusted reverse proxies (comma-separated IP addresses or hostnames)
# Disallows 'testclient' when ENVIRONMENT=production.
TRUSTED_PROXIES=127.0.0.1,::1,localhost

# ------------------------------------------------------------------------------
# 3. Session & Cookie Security
# ------------------------------------------------------------------------------
# Enforce HTTPS-only Secure cookies.
# Set to 'true' in production (auto-defaults to true when ENVIRONMENT=production).
COOKIE_SECURE=false

# Enable instant 1-click Alex Rivera demo account for local testing.
# Restricted to development mode only; rejected with HTTP 403 in production.
RESII_DEMO_MODE=true

# ------------------------------------------------------------------------------
# 4. Database & File Storage Locations
# ------------------------------------------------------------------------------
# Base data directory for SQLite database, upload storage, and backups.
RESII_DATA_DIR=./data

# Database connection URL (defaults to SQLite WAL-mode inside RESII_DATA_DIR).
# PostgreSQL alternative: postgresql://username:password@localhost:5432/resii_db
DATABASE_URL=sqlite:///./data/resii.db

# Storage path for original uploaded candidate resumes (managed by storage_manager).
RESII_STORAGE_DIR=./data/uploads

# Path for atomic database and storage backup snapshots.
RESII_BACKUP_DIR=./data/backups

# ------------------------------------------------------------------------------
# 5. AI LLM Providers & Inference Configuration
# ------------------------------------------------------------------------------
# Active AI provider. Supported options: 'freeflow', 'ollama', 'openai', 'gemini', 'mock'.
# Falls back deterministically if the selected provider fails.
LLM_PROVIDER=freeflow

# Optional explicit model identifier (e.g. 'llama3:8b', 'gpt-4o', 'gemini-1.5-flash').
LLM_MODEL=

# FreeFlow AI local OpenAI-compatible inference endpoint.
FREEFLOW_API_URL=http://127.0.0.1:8000/v1

# Ollama local inference endpoint.
OLLAMA_API_URL=http://127.0.0.1:11434

# Third-party cloud LLM API keys (Required only if LLM_PROVIDER is openai or gemini).
OPENAI_API_KEY=
GEMINI_API_KEY=
